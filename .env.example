# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koperasi_db

# Security & Authentication
JWT_SECRET=koperasi_secret_jwt_key_super_secure_2026_dev
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=notifications.events

# Whatsapp Gateway
WA_DEVICE_ID=koperasi-app
NOTIF_API_URL=http://localhost:8081/api
NOTIF_API_KEY=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Message Broker Configuration (rabbitmq / kafka)
MESSAGE_BROKER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_NAME=
RABBITMQ_QUEUE_NAME=
